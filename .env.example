HTTP_ADDR=127.0.0.1:8080
DATABASE_PATH=sqlite.db
# Use true behind HTTPS; false permits local HTTP development.
SESSION_COOKIE_SECURE=false
# Disabled until the Phase 0 Instagram feasibility spike passes.
INSTAGRAM_ENABLED=false
# Instagram Login only. Do not add Facebook Login or Page permissions.
# INSTAGRAM_PERMISSIONS=instagram_business_basic,instagram_business_manage_messages
# Optional: poll the dedicated inbox and save inbound DMs as notes for this app user.
# Empty email disables the poller. Interval in seconds (15-3600, default 60).
# INSTAGRAM_INBOX_OWNER_EMAIL=you@example.com
# INSTAGRAM_POLL_INTERVAL_SECONDS=60
